<script>
  // mobile nav
  document.getElementById('burgerBtn').addEventListener('click', function(){
    document.getElementById('navLinks').classList.toggle('open');
  });

  // preselect interest chip from CTA
  function preselect(label){
    setTimeout(()=>{
      document.querySelectorAll('.interest-opt input').forEach(cb=>{
        if(cb.value.toLowerCase().includes(label.toLowerCase())){
          cb.checked = true;
          cb.closest('.interest-opt').classList.add('selected');
        }
      });
    }, 300);
  }

  document.querySelectorAll('.interest-opt input').forEach(cb=>{
    cb.addEventListener('change', ()=>{
      cb.closest('.interest-opt').classList.toggle('selected', cb.checked);
    });
  });

  function goStep(step){
    // validation
    if(step === 2){
      const checked = document.querySelectorAll('.interest-opt input:checked');
      if(checked.length === 0){ document.getElementById('err1').style.display='block'; return; }
      document.getElementById('err1').style.display='none';
    }
    if(step === 3){
      const name = document.getElementById('fName').value.trim();
      const email = document.getElementById('fEmail').value.trim();
      const phone = document.getElementById('fPhone').value.trim();
      if(!name || !email || !phone){ document.getElementById('err2').style.display='block'; return; }
      document.getElementById('err2').style.display='none';

      const interests = Array.from(document.querySelectorAll('.interest-opt input:checked')).map(i=>i.value).join(', ');
      document.getElementById('sumInterest').textContent = interests;
      document.getElementById('sumName').textContent = name;
      document.getElementById('sumEmail').textContent = email;
      document.getElementById('sumPhone').textContent = phone;
      document.getElementById('sumCountry').textContent = document.getElementById('fCountry').value || '—';
    }

    document.querySelectorAll('.form-step').forEach(s=>s.classList.remove('active'));
    document.querySelector('.form-step[data-step="'+step+'"]').classList.add('active');

    document.querySelectorAll('.step-dot').forEach(dot=>{
      const n = parseInt(dot.dataset.step);
      dot.classList.remove('active','done');
      if(n < step) dot.classList.add('done');
      if(n === step) dot.classList.add('active');
    });
  }

  // ===== EMAILJS CONFIG =====
  // 1. Create a free account at https://www.emailjs.com (200 emails/month, 2 templates free)
  // 2. Add an Email Service (connect your Gmail/Outlook) -> copy the Service ID
  // 3. Create Template #1 "Notify Team" -> send TO support@genivagloballtd.com
  //    Use variables: {{name}} {{email}} {{phone}} {{country}} {{interests}}
  // 4. Create Template #2 "Auto-Reply" -> send TO {{email}} (the visitor)
  //    Write a short thank-you message using {{name}} and {{interests}}
  // 5. Account -> General -> copy your Public Key
  // 6. Paste all four values below in place of the YOUR_... placeholders
  const EMAILJS_PUBLIC_KEY   = 'YOUR_PUBLIC_KEY';
  const EMAILJS_SERVICE_ID   = 'YOUR_SERVICE_ID';
  const EMAILJS_TEAM_TEMPLATE = 'YOUR_TEAM_TEMPLATE_ID';
  const EMAILJS_REPLY_TEMPLATE = 'YOUR_AUTOREPLY_TEMPLATE_ID';
  let emailjsReady = false;

  if (EMAILJS_PUBLIC_KEY !== 'YOUR_PUBLIC_KEY' && window.emailjs) {
    emailjs.init({ publicKey: EMAILJS_PUBLIC_KEY });
    emailjsReady = true;
  }

  async function sendAutoEmails(data){
    if(!emailjsReady) return false;
    try{
      await emailjs.send(EMAILJS_SERVICE_ID, EMAILJS_TEAM_TEMPLATE, data);
      await emailjs.send(EMAILJS_SERVICE_ID, EMAILJS_REPLY_TEMPLATE, data);
      return true;
    }catch(e){
      return false;
    }
  }

  async function submitForm(){
    const name = document.getElementById('fName').value.trim();
    const email = document.getElementById('fEmail').value.trim();
    const phone = document.getElementById('fPhone').value.trim();
    const interests = Array.from(document.querySelectorAll('.interest-opt input:checked')).map(i=>i.value).join(', ');
    const country = document.getElementById('fCountry').value || 'Not specified';

    const msg = `Hi Geniva Global, I'm ${name} (${country}). I'm interested in: ${interests}. Email: ${email}, Phone: ${phone}.`;
    document.getElementById('waLink').href = 'https://wa.me/971523162014?text=' + encodeURIComponent(msg);
    document.getElementById('mailLink').href = 'mailto:support@genivagloballtd.com?subject=' + encodeURIComponent('New inquiry: '+interests) + '&body=' + encodeURIComponent(msg);

    // Show success screen immediately so the visitor isn't left waiting
    document.querySelectorAll('.form-step').forEach(s=>s.classList.remove('active'));
    document.querySelector('.form-step[data-step="success"]').classList.add('active');
    document.getElementById('stepsTrack').style.display = 'none';

    // Fire both emails in the background: one to your team, one to the visitor
    const sent = await sendAutoEmails({ name, email, phone, country, interests });
    const noteEl = document.getElementById('autoEmailNote');
    if(noteEl){
      noteEl.textContent = sent
        ? "We've emailed our team, and a confirmation is on its way to your inbox."
        : "Tap a button below to reach us directly.";
    }
  }

  // ===== WELCOME OVERLAY LOGIC =====
  (function(){
    const overlay = document.getElementById('welcomeOverlay');
    const skipBtn = document.getElementById('welcomeSkip');
    const muteBtn = document.getElementById('muteBtn');
    const muteLabel = document.getElementById('muteLabel');
    const text = document.getElementById('welcomeText').textContent.trim();
    let muted = false;
    let utterance = null;
    let closeTimer = null;

    function closeOverlay(){
      overlay.classList.add('hide');
      if(window.speechSynthesis) window.speechSynthesis.cancel();
      clearTimeout(closeTimer);
      setTimeout(()=>{ overlay.style.display='none'; }, 500);
    }

    function pickFemaleVoice(voices){
      const preferred = ['female','samantha','victoria','zira','google us english','aria','jenny','fiona','moira'];
      let match = voices.find(v => preferred.some(p => v.name.toLowerCase().includes(p)));
      if(!match) match = voices.find(v => v.lang && v.lang.startsWith('en'));
      return match || voices[0];
    }

    function speakWelcome(){
      if(!('speechSynthesis' in window)) return;
      utterance = new SpeechSynthesisUtterance(text);
      const voices = window.speechSynthesis.getVoices();
      if(voices.length){
        utterance.voice = pickFemaleVoice(voices);
      } else {
        window.speechSynthesis.onvoiceschanged = () => {
          const v = window.speechSynthesis.getVoices();
          utterance.voice = pickFemaleVoice(v);
        };
      }
      utterance.rate = 0.98;
      utterance.pitch = 1.15;
      window.speechSynthesis.speak(utterance);
    }

    skipBtn.addEventListener('click', closeOverlay);

    muteBtn.addEventListener('click', () => {
      muted = !muted;
      if(muted){
        if(window.speechSynthesis) window.speechSynthesis.cancel();
        muteLabel.textContent = 'Unmute voice';
      } else {
        muteLabel.textContent = 'Mute voice';
        speakWelcome();
      }
    });

    window.addEventListener('load', () => {
      speakWelcome();
      closeTimer = setTimeout(closeOverlay, 30000);
    });
  })();
</script>

