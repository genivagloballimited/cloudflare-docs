<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Geniva Global Limited — Innovate. Automate. Elevate.</title>
<link rel="icon" type="image/png" href="data:image/png;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --navy-deep:#0B1B3F;
    --navy:#132D63;
    --navy-soft:#1E3A73;
    --gold:#C9A227;
    --gold-light:#E8C766;
    --gold-deep:#8C6C14;
    --cream:#F7F4EC;
    --white:#FFFFFF;
    --ink:#16192B;
    --muted:#5B6178;
    --line:#E4DFD0;
    --radius:14px;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html{scroll-behavior:smooth;}
  body{
    font-family:'Inter',sans-serif;
    background:var(--cream);
    color:var(--ink);
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
  h1,h2,h3,h4{font-family:'Poppins',sans-serif;color:var(--navy-deep);line-height:1.15;}
  a{color:inherit;text-decoration:none;}
  img{max-width:100%;display:block;}
  .wrap{max-width:1180px;margin:0 auto;padding:0 24px;}
  .eyebrow{
    display:inline-flex;align-items:center;gap:8px;
    font-family:'Inter',sans-serif;font-weight:700;font-size:12px;letter-spacing:.16em;
    text-transform:uppercase;color:var(--gold-deep);
  }
  .eyebrow::before{content:'';width:22px;height:2px;background:var(--gold);display:inline-block;}
  section{padding:88px 0;}
  @media(max-width:720px){section{padding:56px 0;}}

  /* ===== HEADER ===== */
  header{
    position:sticky;top:0;z-index:100;
    background:rgba(247,244,236,.92);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  .nav{display:flex;align-items:center;justify-content:space-between;padding:14px 24px;max-width:1180px;margin:0 auto;}
  .brand{display:flex;align-items:center;gap:10px;}
  .brand svg{width:38px;height:38px;flex-shrink:0;}
  .brand-text{font-family:'Poppins',sans-serif;font-weight:700;font-size:18px;color:var(--navy-deep);letter-spacing:.02em;}
  .brand-text span{color:var(--gold-deep);}
  .nav-links{display:flex;gap:30px;font-weight:600;font-size:14.5px;}
  .nav-links a{color:var(--navy);opacity:.85;transition:opacity .2s;}
  .nav-links a:hover{opacity:1;color:var(--gold-deep);}
  .nav-cta{
    background:var(--navy-deep);color:var(--white);padding:10px 20px;border-radius:30px;
    font-weight:600;font-size:14px;white-space:nowrap;
    box-shadow:0 4px 14px rgba(11,27,63,.25);
  }
  .nav-cta:hover{background:var(--gold-deep);}
  .burger{display:none;background:none;border:none;cursor:pointer;padding:6px;}
  .burger span{display:block;width:24px;height:2px;background:var(--navy-deep);margin:5px 0;}
  @media(max-width:900px){
    .nav-links{display:none;}
    .burger{display:block;}
    .nav-links.open{
      display:flex;flex-direction:column;position:absolute;top:66px;left:0;right:0;
      background:var(--white);padding:20px 24px;gap:16px;border-bottom:1px solid var(--line);
    }
  }

  /* ===== HERO ===== */
  .hero{padding:70px 0 60px;position:relative;}
  .hero-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center;}
  @media(max-width:900px){.hero-grid{grid-template-columns:1fr;gap:40px;}}
  .hero h1{font-size:clamp(34px,5vw,58px);font-weight:800;margin:14px 0 18px;}
  .hero h1 .accent{color:var(--gold-deep);}
  .hero p.lead{font-size:17.5px;color:var(--muted);max-width:520px;margin-bottom:30px;}
  .hero-ctas{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:34px;}
  .btn{
    display:inline-flex;align-items:center;gap:8px;padding:14px 26px;border-radius:30px;
    font-weight:700;font-size:14.5px;cursor:pointer;border:none;transition:transform .15s, box-shadow .15s;
  }
  .btn:active{transform:scale(.97);}
  .btn-primary{background:linear-gradient(135deg,var(--gold-light),var(--gold));color:var(--navy-deep);box-shadow:0 8px 22px rgba(201,162,39,.35);}
  .btn-primary:hover{box-shadow:0 10px 26px rgba(201,162,39,.5);}
  .btn-outline{background:transparent;border:1.5px solid var(--navy-deep);color:var(--navy-deep);}
  .btn-outline:hover{background:var(--navy-deep);color:var(--white);}
  .hero-tags{display:flex;gap:10px;flex-wrap:wrap;}
  .tag{
    font-size:12.5px;font-weight:600;color:var(--navy);background:var(--white);
    border:1px solid var(--line);padding:7px 14px;border-radius:20px;
  }

  /* Signature: trade-lane globe */
  .globe-wrap{position:relative;display:flex;align-items:center;justify-content:center;}
  .globe-card{
    background:radial-gradient(circle at 30% 25%,var(--navy-soft),var(--navy-deep) 70%);
    border-radius:28px;width:100%;aspect-ratio:1/1;max-width:460px;position:relative;overflow:hidden;
    box-shadow:0 30px 60px rgba(11,27,63,.35);
  }
  .globe-card svg{width:100%;height:100%;}
  .node-label{
    position:absolute;font-family:'Inter',sans-serif;font-size:11px;font-weight:700;
    color:var(--gold-light);background:rgba(11,27,63,.7);padding:4px 9px;border-radius:20px;
    border:1px solid rgba(232,199,102,.4);white-space:nowrap;
  }
  .pulse{animation:pulse 2.4s ease-in-out infinite;}
  @keyframes pulse{0%,100%{opacity:1;r:5;}50%{opacity:.4;r:8;}}
  .lane{stroke-dasharray:6 6;animation:dash 3s linear infinite;}
  @keyframes dash{to{stroke-dashoffset:-120;}}
  @media (prefers-reduced-motion: reduce){
    .pulse,.lane{animation:none;}
  }

  /* ===== TRUST BAR ===== */
  .trust{background:var(--navy-deep);padding:26px 0;}
  .trust .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:18px;color:var(--white);}
  .trust-item{display:flex;align-items:center;gap:10px;font-size:14px;font-weight:600;opacity:.92;}
  .trust-item b{color:var(--gold-light);font-family:'Poppins',sans-serif;font-size:20px;}

  /* ===== SECTION HEADS ===== */
  .section-head{max-width:640px;margin-bottom:46px;}
  .section-head h2{font-size:clamp(26px,3.4vw,38px);margin-top:12px;}
  .section-head p{color:var(--muted);margin-top:12px;font-size:16px;}

  /* ===== SERVICES ===== */
  .services-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;}
  @media(max-width:900px){.services-grid{grid-template-columns:repeat(2,1fr);}}
  @media(max-width:600px){.services-grid{grid-template-columns:1fr;}}
  .svc-card{
    background:var(--white);border:1px solid var(--line);border-radius:var(--radius);
    padding:28px 24px;transition:transform .2s,box-shadow .2s;display:flex;flex-direction:column;gap:14px;
  }
  .svc-card:hover{transform:translateY(-5px);box-shadow:0 16px 34px rgba(11,27,63,.1);border-color:transparent;}
  .svc-icon{
    width:48px;height:48px;border-radius:12px;background:linear-gradient(135deg,var(--navy),var(--navy-deep));
    display:flex;align-items:center;justify-content:center;
  }
  .svc-icon svg{width:24px;height:24px;stroke:var(--gold-light);}
  .svc-card h3{font-size:18.5px;}
  .svc-card p{color:var(--muted);font-size:14.5px;flex:1;}
  .svc-link{font-weight:700;font-size:13.5px;color:var(--gold-deep);display:inline-flex;align-items:center;gap:6px;}
  .svc-link svg{width:14px;height:14px;}

  /* ===== LOGISTICS ===== */
  .logistics{background:var(--white);}
  .lane-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-bottom:44px;}
  @media(max-width:800px){.lane-grid{grid-template-columns:1fr;}}
  .lane-card{
    border:1px solid var(--line);border-radius:var(--radius);padding:24px;
    background:var(--cream);position:relative;overflow:hidden;
  }
  .lane-route{display:flex;align-items:center;gap:10px;font-family:'Poppins',sans-serif;font-weight:700;font-size:16px;color:var(--navy-deep);}
  .lane-route svg{width:20px;height:20px;color:var(--gold-deep);flex-shrink:0;}
  .lane-card p{margin-top:10px;color:var(--muted);font-size:14px;}

  .procure-row{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;}
  @media(max-width:900px){.procure-row{grid-template-columns:repeat(2,1fr);}}
  @media(max-width:520px){.procure-row{grid-template-columns:1fr;}}
  .procure-chip{
    border:1.5px dashed var(--gold);border-radius:var(--radius);padding:20px 16px;text-align:center;
    background:linear-gradient(180deg,#fff,var(--cream));
  }
  .procure-chip svg{width:26px;height:26px;color:var(--navy-deep);margin:0 auto 10px;}
  .procure-chip span{font-weight:700;font-size:14px;color:var(--navy-deep);}

  /* ===== DIGITAL HUB ===== */
  .hub-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px;}
  @media(max-width:700px){.hub-grid{grid-template-columns:1fr;}}
  .hub-card{
    background:var(--navy-deep);border-radius:var(--radius);padding:30px;color:var(--white);
    display:flex;flex-direction:column;gap:12px;position:relative;overflow:hidden;
  }
  .hub-card::after{
    content:'';position:absolute;right:-40px;top:-40px;width:140px;height:140px;border-radius:50%;
    background:radial-gradient(circle,rgba(201,162,39,.35),transparent 70%);
  }
  .hub-card h3{color:var(--white);font-size:20px;}
  .hub-card p{color:#C9D0E6;font-size:14.5px;}
  .hub-card a.btn{align-self:flex-start;margin-top:6px;}

  /* ===== SIGNUP ===== */
  .signup{background:linear-gradient(180deg,var(--navy-deep),var(--navy));}
  .signup .section-head h2, .signup .eyebrow{color:var(--white);}
  .signup .eyebrow{color:var(--gold-light);}
  .signup .section-head p{color:#C9D0E6;}
  .form-card{
    background:var(--white);border-radius:20px;max-width:680px;margin:0 auto;
    box-shadow:0 30px 60px rgba(0,0,0,.3);overflow:hidden;
  }
  .steps-track{display:flex;justify-content:space-between;padding:22px 30px 0;}
  .step-dot{display:flex;flex-direction:column;align-items:center;gap:6px;flex:1;position:relative;}
  .step-dot::before{
    content:'';position:absolute;top:14px;left:-50%;width:100%;height:2px;background:var(--line);z-index:0;
  }
  .step-dot:first-child::before{display:none;}
  .step-dot.active::before, .step-dot.done::before{background:var(--gold);}
  .dot-num{
    width:30px;height:30px;border-radius:50%;background:var(--cream);border:2px solid var(--line);
    display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;color:var(--muted);
    z-index:1;transition:.2s;
  }
  .step-dot.active .dot-num{background:var(--gold);border-color:var(--gold);color:var(--navy-deep);}
  .step-dot.done .dot-num{background:var(--navy-deep);border-color:var(--navy-deep);color:var(--white);}
  .step-dot span.lbl{font-size:11.5px;font-weight:600;color:var(--muted);text-align:center;}
  .form-body{padding:34px 30px 30px;}
  .form-step{display:none;}
  .form-step.active{display:block;animation:fadeIn .3s ease;}
  @keyframes fadeIn{from{opacity:0;transform:translateY(6px);}to{opacity:1;transform:translateY(0);}}
  .form-step h3{font-size:20px;margin-bottom:6px;}
  .form-step .hint{color:var(--muted);font-size:14px;margin-bottom:20px;}
  .interest-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
  @media(max-width:480px){.interest-grid{grid-template-columns:1fr;}}
  .interest-opt{
    display:flex;align-items:center;gap:10px;border:1.5px solid var(--line);border-radius:10px;
    padding:13px 14px;cursor:pointer;font-weight:600;font-size:14px;color:var(--navy);transition:.15s;
  }
  .interest-opt:hover{border-color:var(--gold);}
  .interest-opt.selected{border-color:var(--gold);background:#FFF8E6;}
  .interest-opt input{accent-color:var(--gold-deep);width:16px;height:16px;}
  .field{margin-bottom:16px;}
  .field label{display:block;font-size:13px;font-weight:700;color:var(--navy);margin-bottom:6px;}
  .field input,.field select{
    width:100%;padding:12px 14px;border:1.5px solid var(--line);border-radius:10px;font-size:14.5px;
    font-family:'Inter',sans-serif;color:var(--ink);background:var(--cream);
  }
  .field input:focus,.field select:focus{outline:2px solid var(--gold);border-color:var(--gold);}
  .field-row{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
  @media(max-width:480px){.field-row{grid-template-columns:1fr;}}
  .form-nav{display:flex;justify-content:space-between;margin-top:26px;gap:12px;}
  .form-nav .btn{padding:12px 22px;}
  .err{color:#B23A3A;font-size:13px;margin-top:6px;display:none;}
  .summary-box{background:var(--cream);border-radius:12px;padding:18px;margin-bottom:18px;font-size:14.5px;}
  .summary-box b{color:var(--navy-deep);}
  .success{text-align:center;padding:20px 0;}
  .success svg{width:60px;height:60px;color:var(--gold-deep);margin:0 auto 16px;}
  .success h3{font-size:22px;margin-bottom:8px;}
  .success p{color:var(--muted);margin-bottom:20px;}
  .success .btn{margin:6px;}

  /* ===== FOOTER ===== */
  footer{background:var(--navy-deep);color:#C9D0E6;padding:60px 0 26px;}
  .foot-grid{display:grid;grid-template-columns:1.4fr 1fr 1.2fr;gap:40px;margin-bottom:40px;}
  @media(max-width:800px){.foot-grid{grid-template-columns:1fr;gap:32px;}}
  .foot-brand{display:flex;align-items:center;gap:10px;margin-bottom:14px;}
  .foot-brand svg{width:34px;height:34px;}
  .foot-brand span{font-family:'Poppins',sans-serif;font-weight:700;font-size:17px;color:var(--white);}
  footer h4{color:var(--white);font-family:'Poppins',sans-serif;font-size:14px;margin-bottom:16px;letter-spacing:.04em;text-transform:uppercase;}
  footer ul{list-style:none;display:flex;flex-direction:column;gap:10px;}
  footer ul a{font-size:14.5px;color:#C9D0E6;transition:.15s;}
  footer ul a:hover{color:var(--gold-light);}
  .contact-row{display:flex;align-items:center;gap:10px;font-size:14.5px;margin-bottom:14px;}
  .contact-row svg{width:18px;height:18px;color:var(--gold-light);flex-shrink:0;}
  .social-row{display:flex;gap:12px;margin-top:16px;}
  .social-row a{
    width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,.08);
    display:flex;align-items:center;justify-content:center;transition:.2s;
  }
  .social-row a:hover{background:var(--gold);}
  .social-row svg{width:18px;height:18px;color:var(--white);}
  .foot-bottom{border-top:1px solid rgba(255,255,255,.12);padding-top:22px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;font-size:13px;color:#8B93B0;}

  /* ===== WELCOME OVERLAY ===== */
  #welcomeOverlay{
    position:fixed;inset:0;z-index:1000;
    background:radial-gradient(circle at 30% 20%,rgba(30,58,115,.96),rgba(11,27,63,.98));
    display:flex;align-items:center;justify-content:center;padding:20px;
    opacity:1;transition:opacity .5s ease;
  }
  #welcomeOverlay.hide{opacity:0;pointer-events:none;}
  .welcome-card{
    background:var(--white);border-radius:22px;max-width:420px;width:100%;
    padding:32px 26px 26px;text-align:center;position:relative;
    box-shadow:0 40px 80px rgba(0,0,0,.4);
    animation:popIn .5s cubic-bezier(.2,.9,.3,1.2);
  }
  @keyframes popIn{from{transform:scale(.85);opacity:0;}to{transform:scale(1);opacity:1;}}
  .welcome-skip{
    position:absolute;top:14px;right:16px;background:none;border:none;cursor:pointer;
    font-size:13px;font-weight:700;color:var(--muted);
  }
  .welcome-skip:hover{color:var(--navy-deep);}
  .avatar-wrap{position:relative;width:112px;height:112px;margin:0 auto 16px;}
  .avatar-ring{
    position:absolute;inset:-6px;border-radius:50%;
    border:3px solid var(--gold);
    animation:ringPulse 1.6s ease-in-out infinite;
  }
  @keyframes ringPulse{0%,100%{transform:scale(1);opacity:.6;}50%{transform:scale(1.08);opacity:1;}}
  .avatar-photo-wrap{width:112px;height:112px;border-radius:50%;overflow:hidden;position:relative;box-shadow:0 8px 20px rgba(0,0,0,.2);}
  .avatar-photo{width:100%;height:100%;object-fit:cover;object-position:center 30%;display:block;}
  .talk-bar{
    position:absolute;bottom:8px;width:4px;background:var(--gold-light);border-radius:2px;
    left:50%;box-shadow:0 0 4px rgba(0,0,0,.3);
  }
  .talk-bar.b1{margin-left:-9px;height:6px;animation:talkBar .5s ease-in-out infinite;}
  .talk-bar.b2{margin-left:-1px;height:10px;animation:talkBar .5s ease-in-out infinite .12s;}
  .talk-bar.b3{margin-left:7px;height:6px;animation:talkBar .5s ease-in-out infinite .24s;}
  @keyframes talkBar{0%,100%{transform:scaleY(1);}50%{transform:scaleY(2.2);}}
  .welcome-card h3{font-size:19px;margin-bottom:4px;}
  .welcome-name{font-size:12.5px;font-weight:700;color:var(--gold-deep);letter-spacing:.06em;text-transform:uppercase;margin-bottom:12px;}
  .welcome-card p{color:var(--muted);font-size:14.5px;margin-bottom:20px;}
  .welcome-progress{
    height:5px;background:var(--line);border-radius:10px;overflow:hidden;margin-bottom:18px;
  }
  .welcome-progress-bar{height:100%;background:linear-gradient(90deg,var(--gold),var(--gold-light));width:100%;
    animation:countdown 30s linear forwards;
  }
  @keyframes countdown{from{width:100%;}to{width:0%;}}
  .welcome-actions{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;}
  .welcome-mute{
    display:inline-flex;align-items:center;gap:6px;background:var(--cream);border:1px solid var(--line);
    padding:9px 16px;border-radius:20px;font-size:13px;font-weight:600;cursor:pointer;color:var(--navy);
  }
  .welcome-mute svg{width:15px;height:15px;}
  .welcome-play{
    display:inline-flex;align-items:center;gap:8px;
    background:linear-gradient(135deg,var(--gold-light),var(--gold));color:var(--navy-deep);
    padding:10px 20px;border-radius:20px;font-size:13.5px;font-weight:700;cursor:pointer;border:none;
    box-shadow:0 6px 16px rgba(201,162,39,.4);animation:playPulse 1.8s ease-in-out infinite;
  }
  .welcome-play svg{width:15px;height:15px;}
  .welcome-play.playing{animation:none;box-shadow:none;background:var(--cream);color:var(--navy);}
  @keyframes playPulse{0%,100%{transform:scale(1);}50%{transform:scale(1.05);}}
  .audio-note{font-size:11.5px;color:var(--muted);margin-top:10px;}
</style>
<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
</head>
<body>

<!-- WELCOME OVERLAY -->
<div id="welcomeOverlay">
  <div class="welcome-card">
    <button class="welcome-skip" id="welcomeSkip">Skip ✕</button>
    <div class="avatar-wrap">
      <div class="avatar-ring"></div>
      <div class="avatar-photo-wrap">
        <img src="data:image/png;base64," alt="Olivia, Geniva Global Team" class="avatar-photo">
        <span class="talk-bar b1"></span><span class="talk-bar b2"></span><span class="talk-bar b3"></span>
      </div>
    </div>
    <div class="welcome-name">Olivia · Geniva Global Team</div>
    <h3>Welcome to Geniva Global! 👋</h3>
    <p id="welcomeText">So glad you're here. Whether it's AI skills, automation, a new website, or moving goods between the UAE, Nigeria and China — we've got you covered. Look around, and when you're ready, sign up and our team will follow up personally. Let's innovate, automate, and elevate — together.</p>
    <div class="welcome-progress"><div class="welcome-progress-bar" id="progressBar"></div></div>
    <div class="welcome-actions">
      <button class="welcome-play" id="playBtn">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
        <span id="playLabel">Play Welcome</span>
      </button>
      <button class="welcome-mute" id="muteBtn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 5L6 9H2v6h4l5 4V5z"/><path d="M19 5a12 12 0 010 14M15.5 8.5a7 7 0 010 7"/></svg>
        <span id="muteLabel">Mute voice</span>
      </button>
    </div>
    <p class="audio-note">Browsers block autoplay sound — tap play to hear Olivia.</p>
  </div>
</div>

<header>
  <nav class="nav">
    <a href="#top" class="brand">
      <img src="data:image/png;base64," alt="Geniva Global Limited logo" style="width:38px;height:38px;object-fit:contain;">
      <span class="brand-text">GENIVA <span>GLOBAL</span></span>
    </a>
    <div class="nav-links" id="navLinks">
      <a href="#services">Services</a>
      <a href="#logistics">Logistics</a>
      <a href="#hub">Shop</a>
